# Токен бота, выданный @BotFather
BOT_TOKEN=

# Часовой пояс для расчёта "сегодня" и времени рассылки (по умолчанию Europe/Moscow)
TZ=Europe/Moscow

# Время ежедневной проверки дней рождения в формате ЧЧ:ММ (по умолчанию 09:00)
REMINDER_TIME=09:00

# За сколько дней до ДР присылать предварительное напоминание (по умолчанию 5)
REMIND_DAYS_BEFORE=5

# Путь к файлу базы данных SQLite (по умолчанию ./data/birthdays.db)
DB_PATH=./data/birthdays.db
